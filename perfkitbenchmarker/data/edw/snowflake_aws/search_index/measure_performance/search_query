WITH
  search_rows AS (
  SELECT
    COUNT(*) AS result_rows
  FROM
    SEARCH_INDEX_PROTO_LARGE
  WHERE
    SEARCH(raw_log,
      'ASIA') = TRUE),
  total_rows AS (
  SELECT
    COUNT(*) AS total_row_count
  FROM
    SEARCH_INDEX_PROTO_LARGE),
  index_coverage AS (
    SELECT * FROM TABLE(TABLE_STATUS('SEARCH_INDEX_PROTO_LARGE')))
SELECT
  search_rows.result_rows,
  total_rows.total_row_count,
  index_coverage.SEARCH_OPTIMIZATION_PROGRESS
FROM
  total_rows,
  search_rows,
  index_coverage;